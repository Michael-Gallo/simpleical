#!/usr/bin/env bash
# Repo-local pre-commit hook. Install with: make install-hooks
# Uses the same cache paths as `make pre-commit`.

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1
export PRE_COMMIT_HOME="${PRE_COMMIT_HOME:-$REPO_ROOT/.precommit-cache}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$REPO_ROOT/.cache}"

ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit)

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

if command -v pre-commit >/dev/null; then
	exec pre-commit "${ARGS[@]}"
elif command -v python3 >/dev/null && python3 -c "import pre_commit" 2>/dev/null; then
	exec python3 -mpre_commit "${ARGS[@]}"
elif command -v python >/dev/null && python -c "import pre_commit" 2>/dev/null; then
	exec python -mpre_commit "${ARGS[@]}"
else
	echo '`pre-commit` not found. Did you forget to activate your virtualenv?' 1>&2
	exit 1
fi
